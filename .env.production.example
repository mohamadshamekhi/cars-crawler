# کپی به .env در ~/khodroban/crwoler (gitignored)

# کلید مشترک با cars-api (هم برای احراز /crawl، هم هدر x-api-key درخواست‌ها به api)
CRAWLER_API_KEY=changeme

# آدرس api داخل شبکه‌ی Docker به نام khodroban
CARS_API_BASE_URL=http://api:3000

# سقف کرال‌های همزمان (هر کدام یک Chromium)
MAX_CONCURRENT_CRAWLS=2

# --- build args (فقط هنگام docker compose build) ---
# آینه‌ی pip داخلی؛ خالی = pypi.org
PIP_INDEX_URL=https://pypi.org/simple
# اگر آینه http است، هاست آن را بگذارید
PIP_TRUSTED_HOST=
# هاست جایگزین دانلود Chromium پلی‌رایت؛ خالی = CDN رسمی
PLAYWRIGHT_DOWNLOAD_HOST=
