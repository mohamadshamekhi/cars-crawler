# آدرس پایه cars-api (برای ارسال start/listings/end)
CARS_API_BASE_URL=http://localhost:4000

# کلید مشترک بین backend و این سرویس پایتون (هم برای احراز درخواست ورودی /crawl، هم برای هدر درخواست‌های خروجی به cars-api)
CRAWLER_API_KEY=changeme

# پورتی که این سرویس روی آن اجرا می‌شود (اختیاری)
PORT=8000

# سقف کرال‌های همزمان (هر کدام یک Chromium، حدود 300-500MB RAM)
MAX_CONCURRENT_CRAWLS=2
